# docker compose 会自动读取同目录下的 .env，复制本文件为 .env 后按需修改。
# 所有项都有默认值，不配置也能启动。

# 对外端口与绑定地址
UBR_PORT=8787
# 默认只监听本机，配合 Nginx/Caddy 反代对外提供服务。
# 想直接暴露到局域网/公网改成 0.0.0.0 —— 但请务必同时修改 UBR_ADMIN_PASSWORD。
UBR_BIND=127.0.0.1

# 初始管理员口令（仅在数据卷里还没有口令时生效，之后请在管理后台修改）
UBR_ADMIN_PASSWORD=ubr2024

# 登录有效期（小时）
UBR_SESSION_TTL_HOURS=168

# 单张照片体积上限（MB）
UBR_MAX_PHOTO_MB=8
