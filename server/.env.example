# 服务端配置示例。复制为 .env 或在启动前 export 这些变量。
# 所有项都有默认值，不配置也能跑。

# 监听端口与地址
PORT=8787
HOST=0.0.0.0

# 初始管理员口令。仅在数据库里还没有口令时生效；
# 之后请通过管理后台修改，改这里不会再覆盖已有口令。
UBR_ADMIN_PASSWORD=ubr2024

# 登录凭证有效期（小时），默认 7 天
UBR_SESSION_TTL_HOURS=168

# 单张照片体积上限（MB）
UBR_MAX_PHOTO_MB=8

# 数据目录（数据库与上传的照片都放这里），默认 server/var
# UBR_DATA_DIR=/var/lib/ubr-map

# 前端产物目录，默认 server/public
# UBR_PUBLIC_DIR=/srv/ubr-map/public

# 需要跨域访问 API 时填写来源（例如 http://localhost:5173）。
# 生产环境前后端同源，留空即可。
# UBR_CORS_ORIGIN=

# 设为 1 关闭请求日志
# UBR_QUIET=1
